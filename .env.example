# ==============================================================================
# MedCore HMS — Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database Configuration (MongoDB)
# Supports local MongoDB, MongoDB Atlas, or automatically falls back to embedded in-memory MongoDB
MONGODB_URI=mongodb://localhost:27017/medcore_hms

# JWT & Authentication Security (Minimum 256-bit random secrets)
JWT_SECRET=medcore_jwt_secret_super_secure_key_at_least_256_bits_length_123456789
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=medcore_refresh_token_secret_random_secure_key_987654321
REFRESH_TOKEN_EXPIRES_IN=7d

# Cache & Redis (Optional - in-memory fallback enabled if Redis is not configured)
REDIS_URL=redis://localhost:6379

# Third-Party Integrations (Test/Sandbox credentials)
STRIPE_SECRET_KEY=sk_test_51MockStripeSecretKeyForMedCoreTesting
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook_secret_for_tests
RESEND_API_KEY=re_mock_resend_api_key_for_hospital_emails
TWILIO_ACCOUNT_SID=AC_mock_twilio_account_sid_for_sms
TWILIO_AUTH_TOKEN=mock_twilio_auth_token_for_sms
TWILIO_PHONE_NUMBER=+1234567890

# Frontend public variables
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001
